/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "remote-mcp-server-authless",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["ExecutiveOperator"],
			"tag": "v2",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT",
			},
			{
				"class_name": "ExecutiveOperator",
				"name": "OPERATOR",
			},
		],
	},
	// Executive Operator (Zenzap agent). Secrets are set with `wrangler secret put`:
	// ZENZAP_API_KEY, ZENZAP_API_SECRET, ANTHROPIC_API_KEY (and optionally OWNER_MEMBER_ID).
	"vars": {
		"ZENZAP_BASE_URL": "https://api.us.zenzap.co",
		"ZENZAP_CONTROL_TOPIC_ID": "c1b54c71-bc8c-4562-b9f6-71b448ab8a97",
		"POLL_INTERVAL_SECONDS": "15",
		"AGENT_EFFORT": "medium",
		// Doctrine v2.3 Validator (Custodian): only its messages count as verdicts in the ledger.
		"VALIDATOR_MEMBER_ID": "b@e1f282f7-f03f-4ce5-a88d-6d49e499c2a9",
		// X posting: X_POSTING_ENABLED is the owner's master switch and is
		// managed as a dashboard secret (set 2026-10-14 after a deploy with
		// it as a plain var reset it to OFF). It must NOT be declared here:
		// a vars entry would override the secret on every deploy. Secrets
		// are set with `wrangler secret put` (never in this file):
		// X_CONSUMER_KEY, X_CONSUMER_SECRET, X_ACCESS_TOKEN,
		// X_ACCESS_TOKEN_SECRET, MCP_CLIENT_TOKENS.
	},
	// Zenzap docs and raw API payloads saved for inspection (see src/research.ts).
	"d1_databases": [
		{
			"binding": "RESEARCH",
			"database_name": "executive-operator-research",
			"database_id": "61ce2e77-3b2a-4e5d-ac19-75a38a857214",
		},
	],
	"triggers": {
		"crons": [],
	},
	"observability": {
		"enabled": true,
	},
}
